generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String             @id @default(cuid())
  firebaseUid         String             @unique
  email               String             @unique
  name                String?
  photoUrl            String?
  role                Role               @default(PLAYER)
  emailVerified       Boolean            @default(false)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  bookings            Booking[]
  favourites          Favourite[]
  hostedMatches       Match[]            @relation("HostedMatches")
  matchParticipations MatchParticipant[]
  providerProfile     ProviderProfile?
}

model ProviderProfile {
  id                 String             @id @default(cuid())
  userId             String             @unique
  businessName       String
  contactPhone       String?
  verificationStatus VerificationStatus @default(PENDING)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  turfs              Turf[]
}

model Sport {
  id        String      @id @default(cuid())
  name      String      @unique
  slug      String      @unique
  icon      String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  matches   Match[]
  turfs     TurfSport[]
}

model Turf {
  id           String             @id @default(cuid())
  name         String
  description  String?
  location     String
  latitude     Float?
  longitude    Float?
  pricePerHour Float
  courts       Int                @default(1)
  images       String[]           @default([])
  status       String             @default("active")
  isDeleted    Boolean            @default(false)
  deletedAt    DateTime?
  providerId   String
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  slots        AvailabilitySlot[]
  bookings     Booking[]
  favourites   Favourite[]
  reviews      Review[]
  provider     ProviderProfile    @relation(fields: [providerId], references: [id], onDelete: Cascade)
  sports       TurfSport[]

  @@index([providerId])
  @@index([isDeleted])
}

model TurfSport {
  turfId  String
  sportId String
  sport   Sport  @relation(fields: [sportId], references: [id], onDelete: Cascade)
  turf    Turf   @relation(fields: [turfId], references: [id], onDelete: Cascade)

  @@id([turfId, sportId])
}

model AvailabilitySlot {
  id        String     @id @default(cuid())
  turfId    String
  date      DateTime
  startTime String
  endTime   String
  status    SlotStatus @default(AVAILABLE)
  price     Float?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  turf      Turf       @relation(fields: [turfId], references: [id], onDelete: Cascade)
  booking   Booking?

  @@unique([turfId, date, startTime])
  @@index([turfId, date])
}

model Favourite {
  id        String   @id @default(cuid())
  userId    String
  turfId    String
  createdAt DateTime @default(now())
  turf      Turf     @relation(fields: [turfId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, turfId])
  @@index([userId])
}

model Booking {
  id          String           @id @default(cuid())
  userId      String
  turfId      String
  createdAt   DateTime         @default(now())
  cancelledAt DateTime?
  cancelledBy CancelledBy?
  slotId      String           @unique
  status      BookingStatus    @default(CONFIRMED)
  totalPrice  Decimal
  updatedAt   DateTime         @updatedAt
  slot        AvailabilitySlot @relation(fields: [slotId], references: [id])
  turf        Turf             @relation(fields: [turfId], references: [id])
  user        User             @relation(fields: [userId], references: [id])
  match       Match?

  @@index([userId])
  @@index([turfId])
  @@index([status])
}

model Match {
  id               String             @id @default(cuid())
  bookingId        String             @unique
  hostId           String
  sportId          String
  description      String?
  status           MatchStatus        @default(OPEN)
  skillLevel       SkillLevel         @default(MIXED)
  maxPlayers       Int
  participantCount Int                @default(1)
  visibility       MatchVisibility    @default(PUBLIC)
  cancelledAt      DateTime?
  cancelReason     String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  booking          Booking            @relation(fields: [bookingId], references: [id])
  host             User               @relation("HostedMatches", fields: [hostId], references: [id])
  sport            Sport              @relation(fields: [sportId], references: [id])
  participants     MatchParticipant[]

  @@index([hostId])
  @@index([status])
  @@index([sportId])
  @@index([visibility])
  @@index([status, visibility])
}

model MatchParticipant {
  id       String          @id @default(cuid())
  joinedAt DateTime        @default(now())
  matchId  String
  role     ParticipantRole @default(PLAYER)
  userId   String
  match    Match           @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId])
  @@index([matchId])
}

model Review {
  id        String   @id @default(cuid())
  turfId    String
  rating    Int
  createdAt DateTime @default(now())
  turf      Turf     @relation(fields: [turfId], references: [id])
}

enum Role {
  PLAYER
  PROVIDER
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SlotStatus {
  AVAILABLE
  BLOCKED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum CancelledBy {
  PLAYER
  PROVIDER
  SYSTEM
}

enum MatchStatus {
  OPEN
  FULL
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  MIXED
}

enum ParticipantRole {
  HOST
  PLAYER
}

enum MatchVisibility {
  PUBLIC
  PRIVATE
}
